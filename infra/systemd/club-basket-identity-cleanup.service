[Unit]
Description=Club Basket identity cleanup
After=postgresql.service

[Service]
Type=oneshot
User=club-basket
Group=club-basket
WorkingDirectory=/opt/club-basket
EnvironmentFile=/etc/club-basket/app.env
ExecStart=/usr/bin/node /opt/club-basket/apps/api/dist/modules/identity/cleanup.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
