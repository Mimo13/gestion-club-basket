[Unit]
Description=Club Basket API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=club-basket
Group=club-basket
WorkingDirectory=/opt/club-basket
EnvironmentFile=/etc/club-basket/app.env
ExecStart=/usr/bin/node /opt/club-basket/apps/api/dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/club-basket

[Install]
WantedBy=multi-user.target
