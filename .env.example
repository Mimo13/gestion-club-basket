# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL local. En producción se recomienda un usuario propio de la aplicación.
DATABASE_URL=postgresql://club_basket_app:CAMBIAR_PASSWORD@127.0.0.1:5432/club_basket

# Almacenamiento local Linux
STORAGE_ROOT=./var/storage

# Seguridad: generar un valor aleatorio largo antes de usar en producción
SESSION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
SESSION_TTL_DAYS=30
